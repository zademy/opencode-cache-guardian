{
  "name": "opencode-cache-guardian",
  "version": "0.1.0",
  "description": "Local-first, deterministic prompt-cache stability observer for OpenCode V2. Observe mode makes zero prompt mutations.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "build": "bun build src/index.ts --outdir dist --target bun --format esm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opencode/ai": "2.0.26",
    "@opencode/plugin": "2.0.26",
    "@opencode/schema": "2.0.26",
    "@types/bun": "1.4.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.26"
  }
}
